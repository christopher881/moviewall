NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin password gate. If left blank, the admin is fully open (no login).
# Set this to require a password before the admin loads.
ADMIN_PASSWORD=

# Random string used to sign the auth cookie so it can't be forged.
# Generate one with:  openssl rand -hex 32
AUTH_COOKIE_SECRET=
